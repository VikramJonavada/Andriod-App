pipeline {
    agent {
        docker { image 'cimg/android:2023.09.1' }
    }
    environment {
        DIR = 'Andriod-App/helloworld/helloworld2'
    }
    stages {
        stage('Setup') {
          steps {
            dir(DIR) {
              sh 'chmod +x gradle'
            }
          }
        }
        stage('Build') {
          steps {
            dir(DIR) {
                sh 'gradle build'
            }
          }
        }
        stage('Run tests') {
            steps {
                dir(DIR) {
                    sh 'gradle test'
                }
            }
        }
    }
    post {
        always {
            cleanWs()
        }
    }
}
